[Unit]
Description=NextKeyBor daemon (dictation, suggestions, GIFs, physical keyboard detection)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.nextkeybor.Daemon
ExecStart=@BINDIR@/nextkeybord
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
